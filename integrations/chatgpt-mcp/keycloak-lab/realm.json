{
  "realm": "deepharness-mcp-lab",
  "enabled": true,
  "accessTokenLifespan": 300,
  "clients": [
    {
      "clientId": "dsh-mcp-resource",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "serviceAccountsEnabled": false,
      "attributes": {
        "resource_url": "https://mcp.example/mcp"
      }
    },
    {
      "clientId": "mcp-ci-probe",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "CI-ONLY-ISOLATED-THROWAWAY",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocolMappers": [
        {
          "name": "resource-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "dsh-mcp-resource",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ]
}
